      "title": "Classification",
      "type": "object"
    },
    "Document": {
      "additionalProperties": false,
      "description": "Регистрационная единица с единым PDF и исходными физическими страницами.",
      "properties": {
        "classification": {
          "$ref": "#/$defs/Classification"
