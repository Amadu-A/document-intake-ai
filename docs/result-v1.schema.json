          "title": "Direction"
        },
        "is_letter": {
          "title": "Is Letter",
          "type": "boolean"
        },
        "template_path": {
          "items": {
            "type": "string"
          },
          "title": "Template Path",
          "type": "array"
        },
        "document_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Document Kind"
        },
        "document_subkind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Subkind"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
