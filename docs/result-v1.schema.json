        "template_path": {
          "items": {
            "type": "string"
          },
          "title": "Template Path",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "template_path"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "Amount": {
      "additionalProperties": false,
      "description": "Денежный факт; расчёты выполняются Decimal, экспорт содержит JSON number.",
