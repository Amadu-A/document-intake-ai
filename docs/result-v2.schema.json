        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quantity"
        },
        "price": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Price"
        },
        "amount": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Amount"
        },
        "delivery_term": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivery Term"
        }
      },
      "title": "DetailedItem",
      "type": "object"
    },
    "DetailedRequisites": {
      "additionalProperties": false,
      "description": "Тот же набор общих полей, но точная денежная сериализация расширенного контракта.",
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "document_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Number"
        },
        "document_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Date"
        },
        "document_date_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Date Raw"
        },
        "sender": {
          "$ref": "#/$defs/Party"
        },
        "recipient": {
          "$ref": "#/$defs/Party"
        },
        "signatories": {
          "items": {
            "$ref": "#/$defs/Signatory"
          },
          "title": "Signatories",
          "type": "array"
        },
        "related_entities": {
          "$ref": "#/$defs/RelatedEntities"
        },
        "amounts": {
          "items": {
            "$ref": "#/$defs/DetailedAmount"
          },
          "title": "Amounts",
          "type": "array"
        },
        "response_required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Required"
        },
        "response_due_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Due Date"
        },
        "delivery_channel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivery Channel"
        },
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "title": "Attachments",
          "type": "array"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/DetailedItem"
          },
          "title": "Items",
          "type": "array"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "title": "DetailedRequisites",
      "type": "object"
    },
    "DisagreementDetails": {
      "additionalProperties": false,
      "description": "Разногласия с сохранением точного вида протокола.",
      "properties": {
        "profile": {
          "const": "D10",
          "title": "Profile",
          "type": "string"
        },
        "parent_contract": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContractReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "disputed_terms": {
          "items": {
            "type": "string"
          },
          "title": "Disputed Terms",
          "type": "array"
        },
        "total_amount": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Amount"
        }
      },
      "required": [
        "profile"
      ],
      "title": "DisagreementDetails",
      "type": "object"
    },
    "DocumentRoot": {
      "description": "Утверждённые владельцем шесть родов документов.",
      "enum": [
        "Внутренние документы компании",
        "Входящая/Исходящая корреспонденция",
        "Договоры",
        "Документы связанные с исполнением договоров",
        "Процессуальные документы",
        "Составляющие документы договора"
      ],
      "title": "DocumentRoot",
      "type": "string"
    },
    "EnforcementDetails": {
      "additionalProperties": false,
      "description": "Специальные факты именно исполнительного листа.",
