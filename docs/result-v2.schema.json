        "profile": {
          "const": "D02",
          "title": "Profile",
          "type": "string"
        },
        "court_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Court Name"
        },
        "court_case_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Court Case Number"
        },
        "issue_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issue Date"
        },
        "claimant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claimant"
        },
        "debtor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Debtor"
        },
        "enforcement_subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enforcement Subject"
        }
      },
      "required": [
        "profile"
      ],
      "title": "EnforcementDetails",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Короткое свидетельство конкретной физической страницы; confidence не выдумывается.",
      "properties": {
        "file_id": {
          "title": "File Id",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "raw": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw"
        },
        "status": {
          "enum": [
            "found",
            "not_present",
            "unreadable",
            "ambiguous",
            "explicit_no_number",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "source": {
          "enum": [
            "image",
            "ocr",
            "context"
          ],
          "title": "Source",
          "type": "string"
        },
