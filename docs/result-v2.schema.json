{
  "$defs": {
    "Alternative": {
      "additionalProperties": false,
      "description": "Сохраняет только допустимый альтернативный путь классификации.",
      "properties": {
        "template_path": {
          "items": {
            "type": "string"
          },
          "title": "Template Path",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "template_path"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "AmendmentDetails": {
      "additionalProperties": false,
      "description": "Предмет и начало действия изменения договора.",
      "properties": {
        "profile": {
          "const": "D09",
          "title": "Profile",
          "type": "string"
        },
        "parent_contract": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContractReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "change_subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change Subject"
        },
        "effective_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Date"
        },
        "total_amount": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Amount"
        }
      },
      "required": [
        "profile"
      ],
      "title": "AmendmentDetails",
      "type": "object"
    },
    "AppendixDetails": {
      "additionalProperties": false,
      "description": "Самостоятельное утверждённое приложение к договору.",
      "properties": {
        "profile": {
          "const": "D11",
          "title": "Profile",
          "type": "string"
        },
        "parent_contract": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContractReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attachment_subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attachment Subject"
        },
        "total_amount": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Amount"
        }
      },
      "required": [
        "profile"
      ],
      "title": "AppendixDetails",
      "type": "object"
    },
    "Attachment": {
      "additionalProperties": false,
      "description": "Приложение к регистрации; пустой page_range означает только упоминание.",
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "page_range": {
          "items": {
            "type": "integer"
          },
          "title": "Page Range",
          "type": "array"
        },
        "document_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Kind"
        },
        "document_root": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentRoot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Attachment",
      "type": "object"
    },
    "AttachmentFile": {
      "additionalProperties": false,
      "description": "Реальный скачиваемый PDF-комплект для одной регистрации.",
      "properties": {
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "file_url": {
          "title": "File Url",
          "type": "string"
        },
        "mime_type": {
          "const": "application/pdf",
          "default": "application/pdf",
          "title": "Mime Type",
          "type": "string"
        }
      },
      "required": [
        "file_name",
        "file_url"
      ],
      "title": "AttachmentFile",
      "type": "object"
    },
    "Classification": {
      "additionalProperties": false,
      "description": "Проверяет род, направление и полный путь до конечного шаблона письма.",
      "properties": {
        "document_root": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentRoot"
            },
            {
              "type": "null"
            }
          ]
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "incoming",
                "outgoing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Direction"
        },
        "is_letter": {
          "title": "Is Letter",
          "type": "boolean"
        },
        "template_path": {
          "items": {
            "type": "string"
          },
          "title": "Template Path",
          "type": "array"
        },
        "document_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Document Kind"
        },
        "document_subkind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Subkind"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/Alternative"
          },
          "title": "Alternatives",
          "type": "array"
        }
      },
      "required": [
        "document_root",
        "direction",
        "is_letter",
        "template_path",
        "document_kind"
      ],
      "title": "Classification",
      "type": "object"
    },
    "ContractDetails": {
      "additionalProperties": false,
      "description": "Срок и предмет договора; роль организации требует подтверждённого контекста.",
      "properties": {
        "profile": {
          "enum": [
            "D04",
            "D05"
          ],
          "title": "Profile",
          "type": "string"
        },
        "contract_subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contract Subject"
        },
        "our_role": {
          "anyOf": [
            {
              "enum": [
                "supplier",
                "customer"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Our Role"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        },
        "total_amount": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Amount"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        }
      },
      "required": [
        "profile"
      ],
      "title": "ContractDetails",
      "type": "object"
    },
    "ContractReference": {
      "additionalProperties": false,
      "description": "Номер/дата договора из скана без ссылки или GUID базы 1С.",
      "properties": {
        "number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        }
      },
      "title": "ContractReference",
      "type": "object"
    },
    "DetailedAmount": {
      "additionalProperties": false,
      "description": "JSON 2.0 сохраняет точное десятичное представление суммы.",
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "DetailedAmount",
      "type": "object"
    },
    "DetailedDocument": {
      "additionalProperties": false,
      "description": "Одна регистрация JSON 2.0 с полным provenance, классификацией и PDF.",
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "segment_index": {
          "minimum": 1,
          "title": "Segment Index",
          "type": "integer"
        },
        "source_pages": {
          "items": {
            "$ref": "#/$defs/PageRef"
          },
          "title": "Source Pages",
          "type": "array"
        },
        "classification": {
          "$ref": "#/$defs/Classification"
        },
        "kind_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Kind Code"
        },
        "kind_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Kind Name"
        },
        "kind_path": {
          "items": {
            "type": "string"
          },
          "title": "Kind Path",
          "type": "array"
        },
        "requisites": {
          "$ref": "#/$defs/DetailedRequisites"
        },
        "details": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "D01": "#/$defs/LetterDetails",
                  "D02": "#/$defs/EnforcementDetails",
                  "D03": "#/$defs/PrimaryDetails",
                  "D04": "#/$defs/ContractDetails",
                  "D05": "#/$defs/ContractDetails",
                  "D06": "#/$defs/ServiceDetails",
                  "D07": "#/$defs/SpecificationDetails",
                  "D08": "#/$defs/SpecificationDetails",
                  "D09": "#/$defs/AmendmentDetails",
                  "D10": "#/$defs/DisagreementDetails",
                  "D11": "#/$defs/AppendixDetails"
                },
                "propertyName": "profile"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/LetterDetails"
                },
                {
                  "$ref": "#/$defs/EnforcementDetails"
                },
                {
                  "$ref": "#/$defs/PrimaryDetails"
                },
                {
                  "$ref": "#/$defs/ContractDetails"
                },
                {
                  "$ref": "#/$defs/ServiceDetails"
                },
                {
                  "$ref": "#/$defs/SpecificationDetails"
                },
                {
                  "$ref": "#/$defs/AmendmentDetails"
                },
                {
                  "$ref": "#/$defs/DisagreementDetails"
                },
                {
                  "$ref": "#/$defs/AppendixDetails"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Details"
        },
        "field_evidence": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/Evidence"
            },
            "type": "array"
          },
          "title": "Field Evidence",
          "type": "object"
        },
        "one_c": {
          "$ref": "#/$defs/OneC"
        },
        "recognition": {
          "$ref": "#/$defs/Recognition"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "attachment_file": {
          "$ref": "#/$defs/AttachmentFile"
        }
      },
      "required": [
        "document_id",
        "segment_index",
        "source_pages",
        "classification",
        "kind_code",
        "kind_name",
        "kind_path",
        "requisites",
        "details",
        "field_evidence",
        "one_c",
        "recognition",
        "warnings",
        "attachment_file"
      ],
      "title": "DetailedDocument",
      "type": "object"
    },
    "DetailedItem": {
      "additionalProperties": false,
      "description": "Товарные строки JSON 2.0 сохраняют десятичные строки.",
      "properties": {
        "line_no": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
