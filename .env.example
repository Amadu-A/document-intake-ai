# .env.example
# Полный каталог настроек; .env содержит только секреты и частные overrides.
COMPOSE_PROJECT_NAME=document-intake-ai
APP_BIND=0.0.0.0
APP_PORT=8084
APP_PUBLIC_BASE_URL=http://192.168.55.3:8084
COOKIE_SECURE=false
LOG_LEVEL=INFO
DATA_DIR=/data
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=document_intake
DATABASE_USER=document_intake
DATABASE_PASSWORD=
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_CONTAINER=shared-rabbitmq-1
RABBITMQ_USER=document_intake
RABBITMQ_VHOST=document-intake
RABBITMQ_QUEUE=document-intake.jobs
RABBITMQ_PASSWORD=
RABBITMQ_TIMEOUT_SECONDS=20
API_KEYS={}
SESSION_SECRET=
DOWNLOAD_SECRET=
DOCLING_BASE_URL=http://docling-eval:5001
DOCLING_API_KEY=
# Допустимый preset определяется GET /v1/capabilities существующего Docling.
DOCLING_OCR_PRESET=tesseract
# JSON-массив языков; iso:ru/iso:en проверены на текущем runtime Docling.
DOCLING_OCR_LANGUAGES=["iso:ru","iso:en"]
DOCLING_TIMEOUT_SECONDS=180
DOCLING_WINDOW_PAGES=20
DOCLING_MAX_REQUEST_MB=45
SHARED_VLM_BASE_URL=http://shared-vlm:8000/v1
SHARED_VLM_MODEL=shared-vlm
# Управление reasoning только для запросов приложения, без изменения shared runtime.
VLM_ENABLE_THINKING=false
VLM_TIMEOUT_SECONDS=180
VLM_WINDOW_PAGES=8
VLM_OVERLAP_PAGES=2
VLM_RECONCILIATION_WINDOWS=4
VLM_MAX_TOKENS=16000
MODEL_ATTEMPTS=3
WORKER_CONCURRENCY=1
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=3
QUEUE_MAX_DEPTH=100
# Это конечные бюджеты, а не обещание скорости обработки 1000 страниц.
JOB_TIMEOUT_SECONDS=14400
QUEUE_TIMEOUT_SECONDS=1800
PREVIEW_TIMEOUT_SECONDS=3600
CONFIRMATION_TIMEOUT_SECONDS=3600
RETENTION_SECONDS=3600
SESSION_TTL_SECONDS=86400
UPLOAD_MAX_MB=1024
UPLOAD_MAX_FILE_MB=400
UPLOAD_MAX_FILE_PAGES=1000
DOCUMENT_MAX_MB=400
DOCUMENT_MAX_PAGES=1000
UPLOAD_MAX_FILES=20
UPLOAD_MAX_PAGES=2000
UPLOAD_TIMEOUT_SECONDS=600
HTTP_JSON_MAX_MB=4
STORAGE_MIN_FREE_MB=1024
IMAGE_MAX_PIXELS=40000000
RENDER_MAX_SIDE=1600
CONVERSION_TIMEOUT_SECONDS=900
RATE_LIMIT_PER_MINUTE=120
MAX_OWNER_ACTIVE_JOBS=4
HEALTH_CACHE_SECONDS=60
